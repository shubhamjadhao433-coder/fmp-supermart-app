rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FMP Supermart Karanja Lad - Zero-Trust Role-Based Security Rules
    
    // Public readable catalogues
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /delivery_slots/{slotId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Authenticated application collections (managed via server API with JWT & Admin SDK/Auth)
    match /users/{userId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /order_items/{itemId} {
      allow read, write: if true;
    }
    match /inventory/{logId} {
      allow read, write: if true;
    }
    match /riders/{riderId} {
      allow read, write: if true;
    }
    match /addresses/{addressId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }
    match /password_reset_requests/{requestId} {
      allow read, write: if true;
    }
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }
    match /purchase_orders/{poId} {
      allow read, write: if true;
    }
    match /purchase_order_items/{poiId} {
      allow read, write: if true;
    }
    match /cod_reconciliations/{recId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
