rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FMP Supermart - Zero-Trust Role-Based Security Rules
    // NOTE: Client browsers never receive write access to Firestore collections.
    // All mutations, authentication checks, RBAC, and atomic transactions execute
    // exclusively through the hardened Express backend API.

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Public read-only marketplace discovery catalogues
    match /categories/{categoryId} {
      allow read: if resource.data.is_active != false;
      allow write: if false;
    }

    match /stores/{storeId} {
      allow read: if resource.data.approval_status == 'approved' && resource.data.is_active != false;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.is_deleted != true &&
                     resource.data.is_active != false &&
                     resource.data.store_id is int &&
                     resource.data.store_id > 0;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    // Public safe platform status only (explicitly deny internal/private configs)
    match /settings/platform_config {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{settingId} {
      allow read, write: if false;
    }

    // Sensitive & transactional collections — denied to direct client SDK access
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.customer_id == request.auth.token.user_id);
      allow write: if false;
    }

    match /order_items/{itemId} {
      allow read, write: if false;
    }

    match /order_idempotency/{keyId} {
      allow read, write: if false;
    }

    match /payment_history/{paymentId} {
      allow read, write: if false;
    }

    match /inventory/{logId} {
      allow read, write: if false;
    }

    match /addresses/{addressId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.token.user_id;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.token.user_id;
      allow write: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.customer_id == request.auth.token.user_id;
      allow write: if false;
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reporter_id == request.auth.token.user_id);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /password_reset_requests/{requestId} {
      allow read, write: if false;
    }

    match /_counters/{counterId} {
      allow read, write: if false;
    }

    // Retired legacy central warehouse & rider collections — permanently locked
    match /riders/{riderId} {
      allow read, write: if false;
    }
    match /suppliers/{supplierId} {
      allow read, write: if false;
    }
    match /purchase_orders/{poId} {
      allow read, write: if false;
    }
    match /purchase_order_items/{poiId} {
      allow read, write: if false;
    }
    match /cod_reconciliations/{recId} {
      allow read, write: if false;
    }
    match /delivery_slots/{slotId} {
      allow read, write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
