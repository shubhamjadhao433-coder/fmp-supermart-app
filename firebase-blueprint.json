{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile including customers, administrators, and delivery riders",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "description": "10-digit mobile number" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["customer", "admin", "rider", "store_owner"], "description": "System role" },
        "store_id": { "type": "number", "description": "Owned store ID for store owners" },
        "address": { "type": "string", "description": "Delivery address in Karanja Lad" },
        "landmark": { "type": "string", "description": "Nearby landmark" },
        "city": { "type": "string", "description": "City e.g. Karanja Lad" },
        "pincode": { "type": "string", "description": "Pin code (e.g. 444105)" },
        "is_active": { "type": "boolean", "description": "Account status" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "name", "role"]
    },
    "categories": {
      "title": "Category",
      "description": "Product category in supermarket",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image_url": { "type": "string" },
        "display_order": { "type": "number" },
        "is_active": { "type": "boolean" }
      },
      "required": ["name", "slug"]
    },
    "products": {
      "title": "Product",
      "description": "Store item available in Karanja Lad warehouse",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category_id": { "type": "string" },
        "unit": { "type": "string" },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "discount_percent": { "type": "number" },
        "stock": { "type": "number" },
        "image_url": { "type": "string" },
        "description": { "type": "string" },
        "is_active": { "type": "boolean" },
        "product_type": { "type": "string", "enum": ["loose", "packaged"] },
        "min_order_qty": { "type": "number" },
        "max_order_qty": { "type": "number" },
        "pricing_slabs": { "type": "array" },
        "purchase_cost": { "type": "number" },
        "gross_margin": { "type": "number" },
        "margin_percent": { "type": "number" },
        "supplier_id": { "type": "number" },
        "supplier_name": { "type": "string" },
        "supplier_phone": { "type": "string" },
        "supplier_address": { "type": "string" },
        "store_id": { "type": "number" },
        "store_name": { "type": "string" },
        "is_deleted": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "stock"]
    },
    "stores": {
      "title": "Store",
      "description": "Independent registered kirana/grocery store in FMP Supermart",
      "type": "object",
      "properties": {
        "owner_id": { "type": "number" },
        "owner_name": { "type": "string" },
        "owner_phone": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "landmark": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "logo_url": { "type": "string" },
        "banner_url": { "type": "string" },
        "photos": { "type": "array" },
        "opening_hours": { "type": "string" },
        "opening_time": { "type": "string" },
        "closing_time": { "type": "string" },
        "weekly_closed_days": { "type": "array" },
        "service_type": { "type": "string", "enum": ["delivery", "pickup", "both"] },
        "delivery_radius_km": { "type": "number" },
        "delivery_fee": { "type": "number" },
        "min_order_amount": { "type": "number" },
        "delivery_info": { "type": "string" },
        "approval_status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "is_active": { "type": "boolean" },
        "is_open": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["owner_id", "name", "address", "lat", "lng", "service_type", "approval_status"]
    },
    "complaints": {
      "title": "Complaint",
      "description": "Customer or store reported problem for admin resolution",
      "type": "object",
      "properties": {
        "reporter_id": { "type": "number" },
        "reporter_name": { "type": "string" },
        "reporter_phone": { "type": "string" },
        "store_id": { "type": "number" },
        "order_id": { "type": "number" },
        "product_id": { "type": "number" },
        "product_name": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_review", "resolved", "rejected"] },
        "admin_notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["reporter_id", "subject", "description", "status"]
    },
    "orders": {
      "title": "Order",
      "description": "Customer COD grocery order with OTP verification or store pickup",
      "type": "object",
      "properties": {
        "order_number": { "type": "string" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_phone": { "type": "string" },
        "store_id": { "type": "number" },
        "store_name": { "type": "string" },
        "fulfillment_type": { "type": "string", "enum": ["delivery", "pickup"] },
        "delivery_address": { "type": "string" },
        "landmark": { "type": "string" },
        "pincode": { "type": "string" },
        "subtotal": { "type": "number" },
        "regular_subtotal": { "type": "number" },
        "total_savings": { "type": "number" },
        "delivery_fee": { "type": "number" },
        "handling_fee": { "type": "number" },
        "tip_amount": { "type": "number" },
        "total_amount": { "type": "number" },
        "distance_km": { "type": "number" },
        "distance_source": { "type": "string" },
        "customer_lat": { "type": "number" },
        "customer_lng": { "type": "number" },
        "warehouse_lat": { "type": "number" },
        "warehouse_lng": { "type": "number" },
        "delivery_fee_rule": { "type": "string" },
        "payment_mode": { "type": "string", "enum": ["COD", "Pay at Store"] },
        "payment_method": { "type": "string" },
        "payment_status": { "type": "string", "enum": ["pending", "paid", "cancelled"] },
        "status": {
          "type": "string",
          "enum": ["placed", "confirmed", "packed", "dispatched", "delivered", "cancelled"]
        },
        "delivery_type": { "type": "string" },
        "scheduled_date": { "type": "string" },
        "time_slot": { "type": "string" },
        "rider_id": { "type": "string" },
        "rider_name": { "type": "string" },
        "rider_phone": { "type": "string" },
        "delivery_otp": { "type": "string" },
        "pickup_code": { "type": "string" },
        "otp_expires_at": { "type": "string", "format": "date-time" },
        "otp_attempts": { "type": "number" },
        "cod_collected": { "type": "boolean" },
        "cod_reconciled": { "type": "boolean" },
        "failure_reason": { "type": "string" },
        "rejection_reason": { "type": "string" },
        "cancelled_by_role": { "type": "string", "enum": ["customer", "store_owner", "admin"] },
        "cancelled_at": { "type": "string", "format": "date-time" },
        "idempotency_key": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["order_number", "customer_id", "total_amount", "status", "payment_mode"]
    },
    "order_items": {
      "title": "OrderItem",
      "description": "Line items associated with an order",
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "product_id": { "type": "string" },
        "product_name": { "type": "string" },
        "unit": { "type": "string" },
        "product_type": { "type": "string", "enum": ["loose", "packaged"] },
        "price": { "type": "number" },
        "regular_unit_price": { "type": "number" },
        "quantity": { "type": "number" },
        "total": { "type": "number" },
        "savings": { "type": "number" },
        "applied_slab_label": { "type": "string" },
        "image_url": { "type": "string" }
      },
      "required": ["order_id", "product_id", "quantity", "price"]
    },
    "inventory": {
      "title": "InventoryLog",
      "description": "Transactional log of inventory stock changes",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "change_type": { "type": "string" },
        "quantity_change": { "type": "number" },
        "stock_after": { "type": "number" },
        "reference_id": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "quantity_change", "stock_after"]
    },
    "riders": {
      "title": "Rider",
      "description": "Delivery fleet profile and operational metrics",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicle_type": { "type": "string" },
        "status": { "type": "string" },
        "cash_in_hand": { "type": "number" },
        "total_deliveries": { "type": "number" }
      },
      "required": ["user_id", "name", "phone"]
    },
    "addresses": {
      "title": "Address",
      "description": "Saved customer delivery addresses",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "label": { "type": "string" },
        "recipient_name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "landmark": { "type": "string" },
        "pincode": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "is_default": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "address"]
    },
    "notifications": {
      "title": "Notification",
      "description": "In-app notifications for orders and account alerts",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "order_id": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "title", "message"]
    },
    "settings": {
      "title": "Settings",
      "description": "Global supermarket business settings including delivery fees",
      "type": "object",
      "properties": {
        "default_delivery_fee": { "type": "number" },
        "handling_fee": { "type": "number" },
        "min_order_amount": { "type": "number" },
        "delivery_areas": { "type": "string" },
        "warehouse_lat": { "type": "number" },
        "warehouse_lng": { "type": "number" },
        "warehouse_address": { "type": "string" },
        "delivery_pricing_mode": { "type": "string", "enum": ["slabs", "per_km"] },
        "per_km_rate": { "type": "number" },
        "free_delivery_up_to_km": { "type": "number" },
        "max_delivery_distance_km": { "type": "number" },
        "delivery_slabs": { "type": "array" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["default_delivery_fee", "handling_fee"]
    },
    "delivery_slots": {
      "title": "DeliverySlot",
      "description": "Available delivery time windows in Karanja Lad",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "time_window": { "type": "string" },
        "max_orders_per_slot": { "type": "number" },
        "is_active": { "type": "boolean" },
        "display_order": { "type": "number" }
      },
      "required": ["name", "time_window"]
    },
    "reviews": {
      "title": "Review",
      "description": "Product rating and review from verified customers",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "order_id": { "type": "string" },
        "rating": { "type": "number" },
        "review_text": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "customer_id", "rating", "review_text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Customer, Admin, and Rider user profiles"
    },
    "/categories/{categoryId}": {
      "schema": "categories",
      "description": "Grocery catalogue categories"
    },
    "/products/{productId}": {
      "schema": "products",
      "description": "Grocery catalogue products with stock"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Cash on Delivery customer orders"
    },
    "/order_items/{itemId}": {
      "schema": "order_items",
      "description": "Items purchased in an order"
    },
    "/inventory/{logId}": {
      "schema": "inventory",
      "description": "Stock deduction and replenishment audit logs"
    },
    "/riders/{riderId}": {
      "schema": "riders",
      "description": "Delivery partner fleet records and metrics"
    },
    "/addresses/{addressId}": {
      "schema": "addresses",
      "description": "Customer delivery addresses"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "User notification messages"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Store configuration and admin delivery fee settings"
    },
    "/delivery_slots/{slotId}": {
      "schema": "delivery_slots",
      "description": "Delivery scheduling windows"
    },
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Customer product reviews and ratings"
    },
    "/stores/{storeId}": {
      "schema": "stores",
      "description": "Independent registered grocery & kirana stores"
    },
    "/complaints/{complaintId}": {
      "schema": "complaints",
      "description": "Customer and store reported problems for admin review"
    }
  }
}
