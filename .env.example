# FMP Supermart - Hyperlocal Multi-Store Grocery Marketplace
# Environment Configuration

PORT=3000
NODE_ENV=development

# JWT Secret for Auth Tokens (REQUIRED in production; minimum 32 random characters)
JWT_SECRET=

# Comma-separated allowed CORS origins for production (e.g. https://fmpsupermart.in,https://www.fmpsupermart.in)
ALLOWED_ORIGINS=

# Seed behavior (NEVER enable demo credential/catalog seeding in production)
ALLOW_INSECURE_SEED_DEFAULTS=false
